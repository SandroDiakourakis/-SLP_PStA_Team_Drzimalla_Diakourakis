command: split
seed: 42
experiment_name: sand_task1
output_dir: runs
data:
  root_dir: data/task1/training
  manifest_dir: data/manifests
  metadata_file: data/task1/sand_task_1.xlsx
  sample_rate: 8000
  tasks:
  - phonationA
  - phonationE
  - phonationI
  - phonationO
  - phonationU
  - rhythmKA
  - rhythmPA
  - rhythmTA
labels:
  num_classes: 5
  class_names:
  - ALS_Severe (1)
  - ALS_Moderate (2)
  - ALS_Mild (3)
  - ALS_None (4)
  - Healthy (5)
  label_mapping:
    1: ALS_Severe (1)
    2: ALS_Moderate (2)
    3: ALS_Mild (3)
    4: ALS_None (4)
    5: Healthy (5)
split:
  test_size: 0.2
  stratify: true
  min_samples_per_subject: 1
features:
  type: mfcc
  mfcc:
    n_mfcc: 20
    n_fft: 2048
    hop_length: 256
    n_mels: 128
    include_deltas: true
    include_delta_deltas: true
    statistics:
    - mean
    - std
    - min
    - max
    - median
    - q25
    - q75
    - iqr
    - skewness
    - kurtosis
    - rms
    - zcr
  egemaps:
    feature_set: eGeMAPSv02
    feature_level: Functionals
model:
  name: xgboost
  use_ensemble: true
  params:
    objective: multi:softmax
    eval_metric: mlogloss
    max_depth: 8
    learning_rate: 0.05
    n_estimators: 2000
    subsample: 0.7
    colsample_bytree: 0.6
    min_child_weight: 3
    gamma: 0.3
    reg_alpha: 0.5
    reg_lambda: 2.0
    scale_pos_weight: 2.0
    random_state: 42
    tree_method: hist
    device: cpu
training:
  cv_folds: 5
  early_stopping_rounds: 100
  use_class_weights: true
  tune_hyperparameters: false
  use_smote: true
  smote_k_neighbors: 3
  smote_sampling_strategy: not majority
  tuning_grid:
    max_depth:
    - 8
    - 10
    learning_rate:
    - 0.05
    - 0.07
    n_estimators:
    - 2000
    min_child_weight:
    - 1
    - 3
    gamma:
    - 0.3
device: mps
verbose: true
save_predictions: true
save_metrics: true
save_confusion_matrix: true
save_feature_importance: true

